@echo off
setlocal

goto args

:args
  if "%1"=="" goto check_tools
  if "%1"=="clean" goto clean
  if "%1"=="apprel" goto check_tools
  if "%1"=="4dos" goto check_tools
  if "%1"=="batcomp" goto check_tools
  if "%1"=="kstack" goto check_tools
  if "%1"=="all" goto check_tools
  if "%1"=="-h" goto help
  if "%1"=="--help" goto help
  echo Unknown argument: %1
  echo Use BUILD --help for usage.
  quit

:help
  echo 4DOS Build Script
  echo.
  echo Usage: BUILD [4dos, batcomp, kstack, apprel, all, clean]
  echo.
  echo By default, builds only 4DOS.COM.
  echo All build targets are incremental and don't delete any files.
  echo.
  echo Commands:
  echo   all         Build all targets
  echo   4dos        Build 4DOS.COM
  echo   batcomp     Build BATCOMP.EXE
  echo   kstack      Build KSTACK.COM
  echo   apprel      Build APPREL.EXE
  echo   clean       Delete build artifacts
  echo   -h, --help  Display this help
  echo.
  quit

:clean
  4dos /c del /y /e %=
    DOS\*.BAK %=
    DOS\*.COM %=
    DOS\*.EXE %=
    DOS\*.MAP %=
    DOS\*.OBJ
  4dos /c del /y /e %=
    4DOSTART.BAK %=
    4DOSTART.LIB %=
    CRITERRS.ASM %=
    INITERRS.ASM %=
    PARSERRS.ASM %=
    SERVERRS.ASM
  4dos /c del /y /e %=
    INTVER.ASM %=
    RELOCSZ.INC %=
    BUILD.TXT %=
    BUILD.DOS %=
    BUILD.DSR %=
    BUILD.W16 %=
    BUILD.H
  4dos /c del /y /e %=
    APPREL.MAP %=
    APPREL.OBJ %=
    MSVC.PDB
  quit

:check_tools
  iff "%MSVC%"=="" .or. not exist %MSVC%\NUL then
    echo ERROR: %%MSVC%% is undefined or does not point to a valid directory
    quit
  endiff
  iff "%MASM%"=="" .or. not exist %MASM%\NUL then
    echo ERROR: %%MASM%% is undefined or does not point to a valid directory
    quit
  endiff
  iff not exist %MSVC%\BIN\CL.EXE then
    echo ERROR: CL.EXE not found in "%MSVC%\BIN"
    quit
  endiff
  iff not exist %MASM%\BIN\ML.EXE then
    echo ERROR: ML.EXE not found in "%MASM%\BIN"
    quit
  endiff
  if "%1"=="apprel" goto apprel
  if "%1"=="all" goto all
  if "%1"=="batcomp" goto batcomp
  if "%1"=="kstack" goto kstack
  goto build

:no_intver
  echo BUILD.BTM: INTVER file is missing
  quit

:bad_intver
  echo BUILD.BTM: INTVER must contain a numeric compatibility ID
  quit

:set_intver
  echo INTVER = %1 > intver.asm
  echo %1 > build.txt
  echo %1 > build.dos
  echo %1 > build.dsr
  echo %1 > build.w16

  rem INTVER contains the compatibility ID
  if not exist INTVER goto no_intver
  set intver=%@line[INTVER,0]

  if "%intver" == "" goto bad_intver

  rem Public version constants used by C sources
  echo BUILD.BTM: Generating version files using internal version %intver
  echo #define VER_BUILD %intver > build.h

  rem Preserve the assembly loader's independent internal version
  echo INTVER = %intver > intver.asm

  rem Legacy plain-text build stamp required by NMAKE
  echo %intver > build.txt
  echo %intver > build.dos
  echo %intver > build.dsr
  echo %intver > build.w16
  return

:build
  if not exist INTVER.ASM gosub set_intver
  if not exist DOS\NUL md DOS
  4dos /e:2048 /c mkproc.btm 4dos 4dos.com msvc dos bp NONE
  quit %?

:batcomp
  if not exist DOS\NUL md DOS
  call MSVC.BTM
  4dos /e:2048 /c mkproc.btm batcomp batcomp.exe msvc dos bp NONE
  quit %?

:kstack
  if not exist DOS\NUL md DOS
  4dos /e:2048 /c mkproc.btm kstack kstack.com msvc dos bp NONE
  quit %?

:apprel
  call MSVC.BTM
  nmake /nologo /f APPREL.MAK
  quit %?

:all
  4dos /e:2048 /c build.btm apprel
  if errorlevel 1 quit %?
  4dos /e:2048 /c build.btm 4dos
  if errorlevel 1 quit %?
  4dos /e:2048 /c build.btm batcomp
  if errorlevel 1 quit %?
  4dos /e:2048 /c build.btm kstack
  quit %?
